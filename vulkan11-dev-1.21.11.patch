diff -ruN a/src/main/java/net/vulkanmod/vulkan/util/AndroidNatives.java b/src/main/java/net/vulkanmod/vulkan/util/AndroidNatives.java
--- a/src/main/java/net/vulkanmod/vulkan/util/AndroidNatives.java	1970-01-01 00:00:00.000000000 +0000
+++ b/src/main/java/net/vulkanmod/vulkan/util/AndroidNatives.java	2026-11-08 08:01:20.476757389 +0000
@@ -0,0 +1,65 @@
+package net.vulkanmod.vulkan.util;
+
+import java.io.File;
+import java.nio.file.Files;
+import java.nio.file.StandardCopyOption;
+
+/**
+ * Android helper: the Android linker refuses to dlopen libraries from shared storage
+ * (/storage/emulated/0). Copy any *.so found in such a directory of org.lwjgl.librarypath
+ * into the first app-private directory of the same path, so LWJGL can load them.
+ */
+public final class AndroidNatives {
+    private static boolean done = false;
+
+    private AndroidNatives() {}
+
+    public static synchronized void install() {
+        if (done) {
+            return;
+        }
+        done = true;
+
+        try {
+            String libraryPath = System.getProperty("org.lwjgl.librarypath");
+            if (libraryPath == null || libraryPath.isEmpty()) {
+                return;
+            }
+
+            File src = null;
+            File dst = null;
+            for (String part : libraryPath.split(File.pathSeparator)) {
+                if (part.isEmpty()) {
+                    continue;
+                }
+                if (part.startsWith("/storage/") || part.startsWith("/sdcard/")) {
+                    if (src == null) {
+                        src = new File(part);
+                    }
+                } else if (dst == null) {
+                    dst = new File(part);
+                }
+            }
+
+            if (src == null || dst == null || !src.isDirectory()) {
+                return;
+            }
+
+            dst.mkdirs();
+            File[] files = src.listFiles((dir, name) -> name.endsWith(".so"));
+            if (files == null) {
+                return;
+            }
+
+            for (File f : files) {
+                File out = new File(dst, f.getName());
+                Files.copy(f.toPath(), out.toPath(), StandardCopyOption.REPLACE_EXISTING);
+                out.setReadable(true, false);
+                out.setExecutable(true, false);
+                System.out.println("[VulkanMod] copied native " + f.getName() + " -> " + out.getAbsolutePath());
+            }
+        } catch (Throwable t) {
+            System.err.println("[VulkanMod] failed to copy natives: " + t);
+        }
+    }
+}
